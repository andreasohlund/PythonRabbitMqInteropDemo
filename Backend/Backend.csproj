<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PythonRabbitMqInterop.Backend</AssemblyName>
    <RootNamespace>PythonRabbitMqInterop.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Messages/OrderConfirmed.cs" Link="Messages/OrderConfirmed.cs" />
    <Compile Include="../Messages/SubmitOrder.cs" Link="Messages/SubmitOrder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NServiceBus" Version="10.2.9" />
    <PackageReference Include="NServiceBus.Extensions.Hosting" Version="4.1.0" />
    <PackageReference Include="NServiceBus.RabbitMQ" Version="11.2.1" />
    <PackageReference Include="NServiceBus.ServicePlatform.Connector" Version="4.0.0" />
  </ItemGroup>

</Project>
